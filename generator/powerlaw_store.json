    "2119927385919262931": {
      "author": "SantimentData",
      "context": "Santiment dice que las billeteras de 1 a 10 BTC sumaron 10.076 BTC en dos semanas y las de 10 a 100 BTC otros 4.131 BTC mientras BTC caía hacia 75K; marca 75K como nivel clave y dice que recuperar 78K y luego 80K reforzaría la idea de un piso local, y que perder los mínimos recientes con esas billeteras vendiendo debilitaría la señal.",
      "created_at": "2026-11-09T22:57:29Z",
      "created_at_chile": "2026-11-09 19:57:29 America/Santiago",
      "created_at_verified": true,
      "cta": "",
