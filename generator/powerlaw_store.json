      "reply_blank": "https://x.com/intent/post?in_reply_to=2120109159194530275",
      "reply_with_suggestion": "https://x.com/intent/post?in_reply_to=2120109159194530275&text=Swapping%20self-custodied%20coins%20for%20IBIT%20shares%20over%20security%20worries%20trades%20one%20risk%20for%20another%3A%20no%20seed%20to%20lose%2C%20but%20now%20you%20hold%20a%20claim%20through%20a%20custodian%20and%20a%20broker.%20Security%20can%20be%20learned%20instead%20of%20outsourced.%20I%20wrote%20a%20book%20on%20building%20your%20own%20air-gapped%20setup%2C%20free%20on%20Kindle%20until%20Wednesday%3A%20https%3A%2F%2Fwww.amazon.com%2Fdp%2FB0HQ5NS31N%3FdplnkId%3Dc09ef739-11f3-4c76-8c62-92ce160a3341%26nodl%3D1",
      "source_post_id": null,
      "suggested_text": "Swapping self-custodied coins for IBIT shares over security worries trades one risk for another: no seed to lose, but now you hold a claim through a custodian and a broker. Security can be learned instead of outsourced. I wrote a book on building your own air-gapped setup, free on Kindle until Wednesday: https://www.amazon.com/dp/B0HQ5NS31N?dplnkId=c09ef739-11f3-4c76-8c62-92ce160a3341&nodl=1",
      "timestamp_source": "x.get_posts_by_ids",
      "topic": "custodia",
      "url": "https://x.com/BullishMarktCap/status/2120109159194530275"
    },
