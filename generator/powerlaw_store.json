        "followers_count": 87957,
        "followers_count_verified": true,
        "min_followers_exclusive": 20000,
        "qualified": true,
        "window_seconds": 7200
      },
      "qualified": true,
      "reply_blank": "https://x.com/intent/post?in_reply_to=2119956990520856643",
      "reply_with_suggestion": "https://x.com/intent/post?in_reply_to=2119956990520856643&text=A%20bank%20charter%20doesn%27t%20change%20Bitcoin%2C%20it%20changes%20who%20holds%20the%20keys%20by%20default.%20Intermediaries%20only%20stay%20optional%20if%20people%20actually%20practice%20withdrawing%20to%20keys%20they%20control.%20That%27s%20the%20part%20adoption%20headlines%20skip.",
      "source_post_id": null,
      "suggested_text": "A bank charter doesn't change Bitcoin, it changes who holds the keys by default. Intermediaries only stay optional if people actually practice withdrawing to keys they control. That's the part adoption headlines skip.",
      "timestamp_source": "x.get_posts_by_ids",
      "topic": "custodia",
      "url": "https://x.com/Diditaihuttu/status/2119956990520856643"
