        "followers_count_verified": true,
        "min_followers_exclusive": 20000,
        "qualified": true,
        "window_seconds": 7200
      },
      "qualified": true,
      "reply_blank": "https://x.com/intent/post?in_reply_to=2119765339257143459",
      "reply_with_suggestion": "https://x.com/intent/post?in_reply_to=2119765339257143459&text=The%20SPX%20divergence%20point%20is%20interesting%2C%20but%20correcting%20together%20can%20also%20mean%20BTC%20keeps%20trading%20as%20a%20risk%20asset%20for%20longer.%20Your%20own%20confirmation%2C%20both%20holding%20their%20lows%20and%20recovering%2C%20is%20the%20part%20I%27d%20wait%20for%20before%20calling%20it%20final.%20What%20level%20breaks%20the%20thesis%20for%20you%3F%20%24BTC",
      "source_post_id": null,
      "suggested_text": "The SPX divergence point is interesting, but correcting together can also mean BTC keeps trading as a risk asset for longer. Your own confirmation, both holding their lows and recovering, is the part I'd wait for before calling it final. What level breaks the thesis for you? $BTC",
      "timestamp_source": "x.get_posts_by_ids",
