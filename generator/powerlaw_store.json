    "2120092764469887020": {
      "author": "dotkrueger",
      "context": "Fred Krueger dice que el power law pone a Bitcoin en «just under 3x by end of 2027», que no ve otro activo grande que haga 3x, y enumera cómo llegar: pivote de la Fed a tasas más bajas, préstamos con Bitcoin masivos, cuellos de botella de energía/permisos para la IA y el trade de la devaluación.",
      "created_at": "2026-11-10T09:54:39Z",
      "created_at_chile": "2026-11-10 06:54:39 America/Santiago",
      "created_at_verified": true,
      "cta": "",
      "exclude_reason": "",
      "first_seen_at": "2026-11-10T11:19:05.196729+00:00",
      "followers_checked_at": "2026-11-10T11:19:05+00:00",
      "followers_count": 388670,
      "followers_count_verified": true,
      "followers_source": "x.get_posts_by_ids.includes.users.public_metrics.followers_count",
      "id": "2120092764469887020",
      "language": "en",
      "last_seen_at": "2026-11-10T11:19:05.196729+00:00",
      "qualification": {
        "age_seconds": 5066.197,
        "exclude_reason": "",
        "followers_checked_at": "2026-11-10T11:19:05+00:00",
        "followers_count": 388670,
        "followers_count_verified": true,
        "min_followers_exclusive": 20000,
        "qualified": true,
        "window_seconds": 7200
      },
      "qualified": true,
      "reply_blank": "https://x.com/intent/post?in_reply_to=2120092764469887020",
      "reply_with_suggestion": "https://x.com/intent/post?in_reply_to=2120092764469887020&text=Just%20under%203x%20by%20end%20of%202027%20is%20where%20the%20trend%20line%20sits%2C%20not%20a%20promise.%20What%20I%20find%20more%20useful%20is%20the%20corridor%20around%20it%3A%20price%20can%20spend%20long%20stretches%20well%20below%20the%20line%2C%20so%20I%20plan%20for%20the%20range%2C%20not%20the%20point.%20My%20projection%20to%202050%2C%20with%20the%20assumptions%3A%20https%3A%2F%2Fx.com%2Fforecastquant%2Fstatus%2F2119169301949141264",
      "source_post_id": null,
      "suggested_text": "Just under 3x by end of 2027 is where the trend line sits, not a promise. What I find more useful is the corridor around it: price can spend long stretches well below the line, so I plan for the range, not the point. My projection to 2050, with the assumptions: https://x.com/forecastquant/status/2119169301949141264",
      "timestamp_source": "x.get_posts_by_ids",
      "topic": "power-law",
      "url": "https://x.com/dotkrueger/status/2120092764469887020"
    },
    "2120097951997653072": {
      "author": "BigDott50",
      "context": "Shahnawaz plantea que #Bitcoin podría seguir un patrón parecido a 2023: rally tras el piso, meses laterales, barrida de liquidez bajo un soporte clave y luego recuperación hacia nuevos máximos; dice que estaríamos en la etapa 3.",
