    "2119956990520856643": {
      "author": "Diditaihuttu",
      "context": "Didi Taihuttu cita la noticia de que Coinbase recibió aprobación federal para operar como trust bank nacional y dice que Bitcoin se creó para hacer opcionales a los intermediarios: «Mass adoption means NOTHING if we sacrifice financial freedom. NOT YOUR KEYS. NOT YOUR COINS.»",
      "created_at": "2026-11-10T00:55:08Z",
      "created_at_chile": "2026-11-09 21:55:08 America/Santiago",
      "created_at_verified": true,
